{
  "name": "menu-man",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import=tsx scripts/run-tests.ts",
    "test:migrations": "node --import=tsx scripts/migration-contract.test.ts",
    "qa:staging": "playwright test",
    "qa:staging:headed": "playwright test --headed",
    "qa:staging:small": "playwright test --project=small-mobile",
    "qa:open:staging": "playwright open --browser=chromium --channel=chrome https://menu-man-git-staging-arencascio.vercel.app/manage/armandos/analytics",
    "import-menu": "node --env-file-if-exists=.env.local --import=tsx scripts/import-menu.ts",
    "import-menu:staging": "node --env-file=.env.staging.local --import=tsx scripts/import-menu.ts --require-staging",
    "audit-images": "node --env-file-if-exists=.env.local --import=tsx scripts/audit-menu-images.ts",
    "import-images": "node --env-file-if-exists=.env.local --import=tsx scripts/import-images.ts",
    "bootstrap-owner:staging": "node --env-file=.env.staging.local --import=tsx scripts/bootstrap-order-management-owner.ts",
    "qa:auth:config-test": "node --test scripts/authenticated-qa-config.test.mjs",
    "qa:auth": "playwright test --config=playwright.auth.config.ts",
    "qa:auth:headed": "playwright test --config=playwright.auth.config.ts --headed",
    "qa:auth:open": "node scripts/open-authenticated-qa.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "posthog-js": "^1.428.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "square": "^45.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
